<Window x:Class="Vector.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector Toolset"
        Background="{StaticResource BgBase}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1" Padding="24,14">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="VECTOR" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="Toolset" Foreground="{StaticResource Text}" FontSize="20" Margin="8,0,0,0"/>
          <TextBlock x:Name="BrandTagline" Foreground="{StaticResource TextDim}" FontSize="12"
                     Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="HeaderShopInfo" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SidebarPanel" Margin="0,10"/>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,22">
        <StackPanel>
          <TextBlock x:Name="ContentTitle" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="ContentDesc" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,0,18"/>
          <WrapPanel x:Name="CardsPanel"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Content="Command Prompt" Style="{StaticResource FooterButton}" Click="OnCmd"/>
          <Button Content="PowerShell" Style="{StaticResource FooterButton}" Click="OnPowerShell"/>
          <Button Content="Explorer" Style="{StaticResource FooterButton}" Click="OnExplorer"/>
          <Button Content="Manage Tools" Style="{StaticResource FooterButton}" Click="OnManage"/>
          <TextBlock x:Name="EnvLabel" Foreground="{StaticResource TextDim}" FontSize="11"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Reboot" Style="{StaticResource FooterDanger}" Click="OnReboot"/>
          <Button Content="Shutdown" Style="{StaticResource FooterDanger}" Click="OnShutdown"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
