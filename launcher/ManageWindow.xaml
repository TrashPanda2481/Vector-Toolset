<Window x:Class="Vector.Launcher.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Tools"
        Background="{StaticResource BgBase}"
        FontFamily="{StaticResource UiFont}"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Tool list -->
      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="TOOLS" Foreground="{StaticResource TextDim}"
                     FontSize="11" FontWeight="SemiBold" Margin="18,16,0,10"/>
          <Grid DockPanel.Dock="Bottom" Margin="12,10">
            <Button Content="Add Tool" Style="{StaticResource FooterButton}" Click="OnAdd" HorizontalAlignment="Left"/>
            <Button Content="Remove" Style="{StaticResource FooterDanger}" Click="OnRemove" HorizontalAlignment="Right"/>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ToolListPanel"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Editor -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel x:Name="EditorPanel">
          <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}" TextChanged="OnNameChanged"/>

          <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TxtDesc" Style="{StaticResource DarkTextBox}" TextChanged="OnDescChanged"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="58" VerticalScrollBarVisibility="Auto"/>

          <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TxtCategory" Style="{StaticResource DarkTextBox}" TextChanged="OnCategoryChanged"/>
          <TextBlock x:Name="CatHint" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"
                     TextWrapping="Wrap"/>

          <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
          <StackPanel x:Name="SegType" Orientation="Horizontal"/>

          <TextBlock Text="RUNS IN" Style="{StaticResource FieldLabel}"/>
          <StackPanel x:Name="SegPlane" Orientation="Horizontal"/>

          <TextBlock Text="PATH" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource FooterButton}"
                    Click="OnBrowse" Margin="6,0,0,0"/>
            <TextBox x:Name="TxtPath" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
          </DockPanel>

          <TextBlock Text="CONSOLE WINDOW" Style="{StaticResource FieldLabel}"/>
          <StackPanel x:Name="SegConsole" Orientation="Horizontal"/>

          <TextBlock Text="LICENSE" Style="{StaticResource FieldLabel}"/>
          <StackPanel x:Name="SegLicense" Orientation="Horizontal"/>

          <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
          <StackPanel x:Name="SegStatus" Orientation="Horizontal"/>

          <TextBlock Text="SOURCE URL" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TxtSource" Style="{StaticResource DarkTextBox}" TextChanged="OnSourceChanged"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" FontSize="12"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Close" Style="{StaticResource FooterButton}" Click="OnClose"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
